{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/*.js": {
      "maxDuration": 15,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "caisse.boulangeriedebabi.com" }],
      "destination": "/caissiere.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "fournil.boulangeriedebabi.com" }],
      "destination": "/gerante.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "admin.boulangeriedebabi.com" }],
      "destination": "/admin.html"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/app/",
      "destination": "/app.html"
    }
  ]
}
