{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "caisse.boulangeriedebabi.com" }],
      "destination": "/caissiere.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "fournil.boulangeriedebabi.com" }],
      "destination": "/gerante.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "admin.boulangeriedebabi.com" }],
      "destination": "/admin.html"
    },
    { "source": "/app", "destination": "/app.html" },
    { "source": "/app/", "destination": "/app.html" },
    { "source": "/api/(.*)", "destination": "/api/index.js" }
  ]
}
